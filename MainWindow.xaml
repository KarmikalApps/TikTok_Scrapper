<Window x:Class="TikTokScrapper.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TikTok Scrapper" Width="760" Height="794" MinWidth="680" MinHeight="720" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanMinimize" Background="#121613" Foreground="#F2F5F3" Icon="Assets/logo.png" FontFamily="Segoe UI" UseLayoutRounding="True" Closing="Window_Closing">
 <Border BorderBrush="#353D37" BorderThickness="1" CornerRadius="12">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="58"/><RowDefinition Height="48"/></Grid.RowDefinitions>
  <Grid Background="Transparent" MouseLeftButtonDown="TitleBar_MouseDown" Margin="26,0,16,0">
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="Assets/logo.png" Width="34" Height="34"/><StackPanel Margin="11,0,0,0"><TextBlock Text="TikTok Scrapper" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="THE PROFILE DOWNLOADER" FontSize="9" Foreground="#87968D" Margin="0,3,0,0"/></StackPanel></StackPanel>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Settings" AutomationProperties.Name="Settings" Click="Settings_Click" Margin="0,0,10,0"/><Border Width="1" Height="18" Background="#343D36" Margin="0,0,10,0"/><Button Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="Minimize_Click"/><Button Style="{StaticResource IconButton}" Content="&#xE8BB;" ToolTip="Close" AutomationProperties.Name="Close" Click="Close_Click"/></StackPanel>
  </Grid>
  <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="38,22,38,28">
    <Grid><StackPanel><TextBlock Text="YOUR FAVORITES. YOUR FOLDER." Foreground="{StaticResource Mint}" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Scrape an entire&#x0a;TikTok profile." FontSize="36" FontWeight="SemiBold" LineHeight="43" Margin="0,10,0,0"/><TextBlock Text="Download videos, photo posts, and avatars." FontSize="14" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,5,0" Width="100" Height="114" Background="#1D2821" CornerRadius="22" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><RotateTransform Angle="8"/></Border.RenderTransform><Image Source="Assets/logo.png" Width="66" Height="66"/></Border></Grid>
    <Border x:Name="ProfileCard" Background="#1C221E" CornerRadius="16" BorderBrush="#303931" BorderThickness="1" Padding="24" Margin="0,28,0,0">
     <StackPanel>
      <Grid Margin="0,0,0,11"><TextBlock Text="URL Profile" FontSize="13" FontWeight="SemiBold"/><TextBlock HorizontalAlignment="Right" Text="TIKTOK" Foreground="#85978B" FontSize="10" FontWeight="SemiBold"/></Grid>
      <Grid><TextBox x:Name="ProfileInput" AutomationProperties.Name="URL Profile" TextChanged="ProfileInput_TextChanged" KeyDown="ProfileInput_KeyDown" Height="52" Padding="42,14,12,14"/><TextBlock Text="&#xE71B;" FontFamily="Segoe Fluent Icons" Foreground="#8C9E91" VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False"/><TextBlock x:Name="Placeholder" Text="https://www.tiktok.com/@username" Foreground="#75847A" FontSize="14" VerticalAlignment="Center" Margin="43,0,0,0" IsHitTestVisible="False"/></Grid>
      <TextBlock x:Name="ValidationText" Text="Paste a profile link to get started." Foreground="#96A59C" FontSize="12" Margin="1,10,0,0" TextWrapping="Wrap"/>
      <Button x:Name="DownloadButton" Style="{StaticResource Primary}" IsEnabled="False" Click="Download_Click" Margin="0,20,0,0" AutomationProperties.Name="Download"><StackPanel Orientation="Horizontal"><TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons" Foreground="#14261D" Margin="0,0,10,0" VerticalAlignment="Center"/><TextBlock Text="Download" Foreground="#14261D" FontWeight="SemiBold" FontSize="15"/></StackPanel></Button>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0"><TextBlock Text="MP4 + Photos" Foreground="#A8B7AD" FontSize="11"/><TextBlock Text="  ·  " Foreground="#526359"/><TextBlock Text="Best available quality" Foreground="#A8B7AD" FontSize="11"/><TextBlock Text="  ·  " Foreground="#526359"/><TextBlock Text="No re-encoding" Foreground="#A8B7AD" FontSize="11"/></StackPanel>
     </StackPanel>
    </Border>
    <Border x:Name="StatusCard" Visibility="Collapsed" Background="#171D19" BorderBrush="#2D3830" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,28,0,0">
     <StackPanel>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Ellipse x:Name="StatusDot" Fill="#728077" Width="7" Height="7" Margin="0,0,9,0"/><TextBlock x:Name="StatusTitle" Text="Ready when you are" FontSize="14" FontWeight="SemiBold"/></StackPanel><Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Padding="10,4" FontSize="11" Visibility="Collapsed" Click="Cancel_Click"/><TextBlock x:Name="PercentText" Grid.Column="1" Text="0%" FontSize="12" Foreground="#91A297" VerticalAlignment="Center"/></Grid>
      <ProgressBar x:Name="OverallProgress" Minimum="0" Maximum="100" Value="0" Margin="0,17,0,0" AutomationProperties.Name="Download progress"/>
      <Grid Margin="0,11,0,0"><TextBlock x:Name="CountText" Text="0 of 0 downloaded" FontSize="12" Foreground="#A9B6AC"/><TextBlock x:Name="ExtraCountText" HorizontalAlignment="Right" Foreground="#E6B88A" FontSize="11"/></Grid>
      <TextBlock x:Name="DetailText" Text="Your download progress will appear here." TextWrapping="Wrap" FontSize="11" Foreground="#85958B" Margin="0,8,0,0" MaxHeight="58" TextTrimming="CharacterEllipsis"/>
      <Expander x:Name="DetailsExpander" Header="Activity details" Foreground="#9CAE9F" FontSize="11" Visibility="Collapsed" Margin="0,10,0,0"><TextBox x:Name="LogText" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10" Height="120" VerticalScrollBarVisibility="Auto" Margin="0,9,0,0" Padding="10"/></Expander>
     </StackPanel>
    </Border>
    <Border x:Name="ResultCard" Visibility="Collapsed" Background="#171D19" BorderBrush="#2D3830" BorderThickness="1" CornerRadius="14" Padding="24" Margin="0,28,0,0">
     <StackPanel>
      <StackPanel Orientation="Horizontal"><Ellipse x:Name="ResultDot" Fill="{StaticResource Mint}" Width="8" Height="8" Margin="0,0,10,0"/><TextBlock x:Name="ResultTitle" Text="Download Completed" Foreground="{StaticResource Mint}" FontSize="19" FontWeight="SemiBold"/></StackPanel>
      <TextBlock x:Name="ResultCount" FontSize="13" Foreground="#CAD7CE" Margin="0,14,0,0"/>
      <TextBlock x:Name="ResultDetail" TextWrapping="Wrap" FontSize="12" Foreground="#94A59A" Margin="0,8,0,0"/>
      <Expander x:Name="ResultDetailsExpander" Header="Activity details" Foreground="#9CAE9F" FontSize="11" Visibility="Collapsed" Margin="0,12,0,0"><TextBox IsReadOnly="True" Text="{Binding Text, ElementName=LogText}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="10" Height="120" VerticalScrollBarVisibility="Auto" Margin="0,9,0,0" Padding="10"/></Expander>
      <Grid x:Name="CompletionButtons" Visibility="Collapsed" Margin="0,24,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions><Button Style="{StaticResource Primary}" Content="Scrap New Profile" Click="NewProfile_Click" Margin="0,0,10,0"/><Button Grid.Column="1" Content="Exit" Click="Close_Click"/></Grid>
     </StackPanel>
    </Border>
   </StackPanel>
  </ScrollViewer>
  <Border Grid.Row="2" BorderBrush="#2B332D" BorderThickness="0,1,0,0" Padding="30,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons" Foreground="#8C9E91" VerticalAlignment="Center"/><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,12,0"><TextBlock Text="SAVING TO" Foreground="#7E9084" FontSize="9"/><TextBlock x:Name="FolderText" Text="./scrapped" FontSize="11" Foreground="#C4D0C8" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/></StackPanel><Button Grid.Column="2" Content="Open folder  ↗" FontSize="11" Background="Transparent" BorderThickness="0" Padding="8,8" Click="OpenFolder_Click"/></Grid></Border>
  <StackPanel Grid.Row="3" HorizontalAlignment="Center" VerticalAlignment="Center">
   <TextBlock Text="Karmikal Apps © 2026" HorizontalAlignment="Center" Foreground="#819588" FontSize="11"/>
   <TextBlock Text="v1.100a" HorizontalAlignment="Center" Foreground="#819588" FontSize="10" Margin="0,3,0,0"/>
  </StackPanel>
  <Grid x:Name="SettingsOverlay" Grid.RowSpan="4" Background="#DD0B100D" Visibility="Collapsed">
   <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center" Margin="0,20">
   <Border Width="600" VerticalAlignment="Center" CornerRadius="18" Background="#1B231E" BorderBrush="#435148" BorderThickness="1" Padding="28">
    <StackPanel><Grid><StackPanel><TextBlock Text="Make yourself at home." FontSize="24" FontWeight="SemiBold"/><TextBlock Text="A few settings. Everything in its place." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"/></StackPanel><Button Style="{StaticResource IconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Content="&#xE8BB;" AutomationProperties.Name="Close settings" Click="CloseSettings_Click"/></Grid>
     <TextBlock Text="Save location" FontSize="13" FontWeight="SemiBold" Margin="0,28,0,10"/>
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="100"/></Grid.ColumnDefinitions><TextBox x:Name="SaveFolderInput" AutomationProperties.Name="Save location" FontSize="12"/><Button Grid.Column="1" Content="Browse" Padding="10,10" Margin="10,0,0,0" Click="BrowseFolder_Click"/></Grid>
     <TextBlock Text="Each profile gets its own folder. Completed files are skipped." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,9,0,0"/>
     <Button Content="Reset to ./scrapped" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Padding="0,10" FontSize="11" Foreground="{StaticResource Mint}" Click="ResetFolder_Click"/>
     <Grid Margin="0,12,0,0"><TextBlock Text="Concurrent downloads" FontSize="13" FontWeight="SemiBold"/><TextBlock x:Name="ConcurrentDownloadsValue" Text="3" Foreground="{StaticResource Mint}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Right"/></Grid>
     <Slider x:Name="ConcurrentDownloadsSlider" Minimum="1" Maximum="10" Value="3" ValueChanged="ConcurrentDownloadsSlider_ValueChanged" TickFrequency="1" IsSnapToTickEnabled="True" TickPlacement="BottomRight" SmallChange="1" LargeChange="1" IsMoveToPointEnabled="True" Foreground="{StaticResource Mint}" Margin="0,12,0,0" AutomationProperties.Name="Concurrent downloads"/>
     <Grid Margin="0,4,0,0"><TextBlock Text="1 · One post at a time" FontSize="11" Foreground="{StaticResource Muted}"/><TextBlock Text="10 · Up to ten at once" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right"/></Grid>
     <TextBlock Text="Default: 3 posts at once. Each slideshow keeps its image order." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
     <CheckBox x:Name="NotifyWhenFinishedCheckBox" IsChecked="False" Foreground="#F2F5F3" FontSize="12" Margin="0,14,0,0" VerticalContentAlignment="Center" Cursor="Hand" AutomationProperties.Name="Play a ding and show a notification when downloads finish">
      <TextBlock Text="Play a ding and show a notification when downloads finish" TextWrapping="Wrap" Margin="6,0,0,0"/>
     </CheckBox>
     <TextBlock Text="Off by default. Windows notification and sound settings apply." Foreground="{StaticResource Muted}" FontSize="11" Margin="23,7,0,0"/>
     <Border Height="1" Background="#354038" Margin="0,14,0,20"/>
     <Grid><StackPanel><TextBlock Text="Download engine" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Keep TikTok compatibility up to date." FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/></StackPanel><Button x:Name="UpdateEngineButton" Content="Check for update" FontSize="12" Padding="14,10" HorizontalAlignment="Right" Click="UpdateEngine_Click"/></Grid>
     <TextBlock x:Name="EngineStatus" Text="Powered by yt-dlp · verified official releases" Foreground="#91A899" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/>
     <Expander Header="Optional TikTok session" Foreground="#CBD8CE" FontSize="12" Margin="0,22,0,0"><StackPanel Margin="0,12,0,0"><TextBlock Text="If TikTok requests login, select a Netscape-format cookies.txt exported from your own TikTok session. It stays on this PC." TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource Muted}"/><Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="92"/><ColumnDefinition Width="66"/></Grid.ColumnDefinitions><TextBox x:Name="CookiesInput" IsReadOnly="True" AutomationProperties.Name="Cookies file" FontSize="11" Padding="10,10"/><Button Grid.Column="1" Content="Choose" FontSize="11" Padding="8" Margin="8,0,0,0" Click="BrowseCookies_Click"/><Button Grid.Column="2" Content="Clear" FontSize="11" Padding="6" Margin="8,0,0,0" Click="ClearCookies_Click"/></Grid></StackPanel></Expander>
     <TextBlock x:Name="SettingsError" Foreground="#F0AA9E" TextWrapping="Wrap" FontSize="12" Margin="0,14,0,0"/>
     <Button x:Name="SaveSettingsButton" Style="{StaticResource Primary}" Content="Save settings" Margin="0,18,0,0" Click="SaveSettings_Click"/>
    </StackPanel>
   </Border>
   </ScrollViewer>
  </Grid>
 </Grid>
 </Border>
</Window>
